				    #"Columnas con nombre cambiado1" = Table.RenameColumns(#"Se expandió DimProductSubcategory.DimProductCategory",{{"DimProductSubcategory.DimProductCategory.SpanishProductCategoryName", "Category Name"}}),
				    #"Valor reemplazado" = Table.ReplaceValue(#"Columnas con nombre cambiado1",null,"Otros",Replacer.ReplaceValue,{"Subcategory Name"}),
				    #"Valor reemplazado1" = Table.ReplaceValue(#"Valor reemplazado",null,"Otros",Replacer.ReplaceValue,{"Category Name"}),
				    #"Personalizada agregada" = Table.AddColumn(#"Valor reemplazado1", "FotoProducto", each "data:image/jpeg;base64," & Binary.ToText([LargePhoto], BinaryEncoding.Base64)),
				    #"Columnas con nombre cambiado2" = Table.RenameColumns(#"Personalizada agregada",{{"FotoProducto", "PhotoProduct"}})
				in
				    #"Columnas con nombre cambiado2"

