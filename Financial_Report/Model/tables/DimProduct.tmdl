				    dbo_DimProduct = AdventureWorksDW2019{[Schema="dbo",Item="DimProduct"]}[Data],
				    #"Columnas quitadas" = Table.RemoveColumns(dbo_DimProduct,{"FactInternetSales", "FactProductInventory", "FactResellerSales", "FrenchProductName", "FrenchDescription", "ChineseDescription", "ArabicDescription", "HebrewDescription", "ThaiDescription", "GermanDescription", "JapaneseDescription", "TurkishDescription"}),
