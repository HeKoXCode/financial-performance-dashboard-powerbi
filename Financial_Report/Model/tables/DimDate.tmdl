	partition DimDate = m
		mode: import
		queryGroup: Consultas
		source =
				let
				    Origen = Sql.Databases("localhost\SQLEXPRESS"),
				    AdventureWorksDW2019 = Origen{[Name="AdventureWorksDW2019"]}[Data],
				    dbo_DimDate = AdventureWorksDW2019{[Schema="dbo",Item="DimDate"]}[Data],
				    #"Columnas quitadas" = Table.RemoveColumns(dbo_DimDate,{"FactCallCenter", "FactCurrencyRate", "FactFinance", "FactInternetSales(DateKey)", "FactInternetSales(DateKey) 2", "FactInternetSales(DateKey) 3", "FactProductInventory", "FactResellerSales(DateKey)", "FactResellerSales(DateKey) 2", "FactResellerSales(DateKey) 3", "FactSalesQuota", "FactSurveyResponse", "FrenchMonthName"}),
				    #"Columnas con nombre cambiado" = Table.RenameColumns(#"Columnas quitadas",{{"FullDateAlternateKey", "Date"}}),
				    #"Columna duplicada" = Table.DuplicateColumn(#"Columnas con nombre cambiado", "CalendarSemester", "CalendarSemester - Copia"),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Columna duplicada",{{"CalendarSemester - Copia", type text}}),
				    #"Valor reemplazado" = Table.ReplaceValue(#"Tipo cambiado","1","Primero",Replacer.ReplaceText,{"CalendarSemester - Copia"}),
				    #"Valor reemplazado1" = Table.ReplaceValue(#"Valor reemplazado","2","Segundo",Replacer.ReplaceText,{"CalendarSemester - Copia"}),
				    #"Filas filtradas" = Table.SelectRows(#"Valor reemplazado1", each true),
				    #"Columnas con nombre cambiado1" = Table.RenameColumns(#"Filas filtradas",{{"CalendarSemester - Copia", "CalendarioSemestre"}})
				in
				    #"Columnas con nombre cambiado1"

	annotation PBI_ResultType = Table

