table DimDate
	dataCategory: Time

	column DateKey
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DateKey

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

