expression DimProductCategory =
		let
		    Origen = Sql.Databases("localhost\SQLEXPRESS"),
		    AdventureWorksDW2019 = Origen{[Name="AdventureWorksDW2019"]}[Data],
		    dbo_DimProductCategory = AdventureWorksDW2019{[Schema="dbo",Item="DimProductCategory"]}[Data],
		    #"Columnas quitadas" = Table.RemoveColumns(dbo_DimProductCategory,{"FrenchProductCategoryName"})
		in
		    #"Columnas quitadas"
	queryGroup: Consultas

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

